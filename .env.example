# Chuỗi kết nối Postgres. Trên Vercel, tạo Storage → Postgres rồi Connect Project
# thì biến POSTGRES_URL được nối tự động và app dùng luôn, không cần khai tay.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Khóa API cấp cho Odoo. Odoo gửi kèm header Authorization: Bearer <khóa này>,
# và khai cùng giá trị vào System Parameter m08_p0801.ssbi_api_key.
SSBI_API_KEY=đặt-một-chuỗi-ngẫu-nhiên-dài
